<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Shared Mind: Inspiration Capture</title>
<style>
@font-face{font-family:'DM Sans';font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'DM Sans';font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'DM Sans';font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'DM Sans';font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Space Grotesk';font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
:root{--bg:#fff;--bg2:#f5f5f7;--ink:#111;--mute:#6b7280;--line:#ececf0;--accent:#ff7a1a;--accent-ink:#c2410c;--soft:#fff3ea;--blue:#2f8fe0;--green:#5fae12;--yellow:#fcd13a;--r:20px;
--font:'DM Sans',-apple-system,"SF Pro Text","Segoe UI",system-ui,sans-serif;--head:'Space Grotesk','DM Sans',system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:var(--font);color:var(--ink);background:#e9e9ee;display:flex;align-items:center;justify-content:center}
#s-home{padding:calc(env(safe-area-inset-top,0px) + 44px) 28px 140px}
#s-home .card{padding:24px}
h1,h2,h3,.big,.date b{font-family:var(--head);font-weight:600}
button,a{font:inherit;color:inherit;touch-action:manipulation}
button{background:none;border:0;cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.phone{position:relative;width:min(100%,400px);height:min(860px,100dvh);background:var(--bg);overflow:hidden;border-radius:40px;box-shadow:0 20px 60px rgba(0,0,0,.12)}
@media(max-width:440px){.phone{border-radius:0;height:100dvh;box-shadow:none}}
.screen{position:absolute;inset:0;overflow-y:auto;padding:calc(env(safe-area-inset-top,0px) + 26px) 20px 120px;opacity:0;visibility:hidden;transform:translateX(14px);transition:opacity .25s,transform .25s,visibility .25s;scrollbar-width:none}
.screen::-webkit-scrollbar{display:none}
.screen.active{opacity:1;visibility:visible;transform:none}
h1{font-size:26px;letter-spacing:-.02em;line-height:1.15}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
.muted{color:var(--mute)}
.card{border:1px solid var(--line);border-radius:var(--r);padding:16px;background:#fff}
.btn{min-height:44px;border-radius:999px;padding:0 18px;font-weight:600;font-size:15px;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}
.btn.dark{background:#111;color:#fff}
.btn:active,.tile:active,.row:active,.thumb:active{opacity:.75}
.link{color:var(--accent-ink);font-weight:600;font-size:15px;min-height:44px;min-width:44px;padding:0 6px;display:inline-flex;align-items:center;justify-content:center;gap:6px}
svg.i{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none}
svg.s{width:18px;height:18px}
/* HOME */
.head{display:flex;align-items:center;gap:14px;margin-bottom:36px}
.date{width:56px;height:56px;border:1px solid var(--line);border-radius:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none}
.date small{font-size:11px;color:var(--mute);letter-spacing:.08em}
.date b{font-size:22px;line-height:1}
.device{display:flex;flex-direction:column;gap:2px;margin-bottom:24px;padding:14px 16px 8px}
.device .top{display:flex;justify-content:space-between;font-size:13px;color:var(--mute);font-weight:500}
.bat{display:inline-flex;align-items:center;gap:6px;color:var(--ink);font-weight:600}
.bat i{width:20px;height:10px;border:1.5px solid var(--green);border-radius:3px;padding:1px;display:block}
.bat i:after{content:"";display:block;height:100%;width:87%;background:var(--green);border-radius:1px}
.device img{width:54%;max-width:200px;margin:0 auto;display:block;mix-blend-mode:multiply}
.sec{display:flex;justify-content:space-between;align-items:center;margin:0 0 14px;min-height:44px}
.strip{display:flex;gap:12px;overflow-x:auto;margin:0 -28px 44px;padding:0 28px;scrollbar-width:none}
.strip::-webkit-scrollbar{display:none}
.thumb{flex:none;width:100px;height:100px;border-radius:18px;overflow:hidden;background:var(--bg2)}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.reflect{border:1px solid #ffd2b0;background:var(--soft);color:var(--accent-ink);padding:0 16px;height:30px;position:relative;border-radius:999px;font-weight:600;font-size:14px;display:inline-flex;align-items:center}
.reflect:before{content:"";position:absolute;inset:-7px -4px}
.big{font-size:34px;font-weight:600;line-height:1;letter-spacing:-.02em}
.chart{display:flex;align-items:flex-end;gap:10px;height:130px;margin-top:44px}
.hl{display:flex;align-items:center;gap:14px}.hl h3{font-size:20px;line-height:1.2;letter-spacing:-.01em}.hl .muted{font-size:14px}
.hico{width:48px;height:48px;border-radius:50%;background:var(--soft);color:var(--accent-ink);display:grid;place-items:center;flex:none}
.bar b{position:relative}.tip{display:none;position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:6px;font-size:13px;font-weight:500;color:var(--mute);white-space:nowrap;font-family:var(--font)}
.bar[aria-pressed=true] .tip{display:block}
.bar b .tip{color:var(--mute);height:auto;line-height:1.2}
.why{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:44px;margin-top:18px;font-size:15px;font-weight:500;color:var(--ink);text-align:left}.why .chev{transition:transform .25s;color:var(--mute)}.why[aria-expanded=true] .chev{transform:rotate(180deg)}
.collapse{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s ease}.collapse>div{overflow:hidden}.collapse.open{grid-template-rows:1fr}
.bar{flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px;min-width:0}
.bar b{width:100%;display:block;border-radius:6px;background:#ffb479;transition:height .6s cubic-bezier(.2,.8,.2,1),background .2s;height:0}
.bar[aria-pressed=true] b{background:var(--accent)}
.bar span{font-size:12px;color:var(--mute);height:14px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.chip{font-size:13px;padding:6px 12px;border-radius:999px;background:var(--bg2);color:#333}
.chip b{font-weight:600}
.insight{font-size:15px;line-height:1.55;color:var(--mute);margin-top:4px}
/* NAV */
.phone:after{content:"";position:absolute;left:0;right:0;bottom:0;height:120px;background:linear-gradient(to top,#fff 35%,rgba(255,255,255,0));pointer-events:none;z-index:15}
.nav{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 18px);transform:translateX(-50%);display:flex;gap:6px;background:#111;border-radius:999px;padding:6px;box-shadow:0 10px 30px rgba(0,0,0,.25);z-index:20;transition:transform .25s,opacity .25s}
.nav.hide{transform:translate(-50%,120px);opacity:0;pointer-events:none}
.nav button{width:58px;height:48px;border-radius:999px;display:grid;place-items:center;color:#9a9aa3}
.nav button[aria-current=page]{color:var(--accent);background:#222}
/* ORGANISE */
.oh{display:flex;align-items:center;justify-content:space-between;min-height:44px}
.oh h1{font-size:24px}
.tabs{display:flex;gap:24px;border-bottom:1px solid var(--line);margin:6px 0 14px}
.tabs button{padding:10px 0;min-height:44px;font-weight:600;font-size:15px;color:var(--mute);border-bottom:2px solid transparent;margin-bottom:-1px}
.tabs button[aria-selected=true]{color:var(--ink);border-color:var(--ink)}
.searchbox{width:100%;height:44px;border:1px solid var(--line);border-radius:12px;padding:0 14px;font:inherit;font-size:15px;margin-bottom:12px;display:none}
.searchbox.show{display:block}
.wrap{display:flex;gap:10px;align-items:flex-start}
.rail{display:none;flex:none;width:72px;position:sticky;top:0;flex-direction:column;gap:12px;padding-right:2px}
.editing .rail{display:flex}
.ritem{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:12px;line-height:1.2;color:#444;text-align:center;border-radius:14px;padding:4px;min-height:44px;border:2px solid transparent}
.ritem img{width:52px;height:52px;border-radius:12px;object-fit:cover;display:block;pointer-events:none}
.ritem.over{border-color:var(--accent);background:var(--soft)}
.ritem.ready{animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{50%{background:var(--soft)}}
.masonry{flex:1;columns:2;column-gap:8px;min-width:0}
.tile{display:block;width:100%;break-inside:avoid;margin-bottom:8px;border-radius:16px;overflow:hidden;position:relative;background:var(--bg2);padding:0;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.tile img{display:block;width:100%;height:auto;pointer-events:none;-webkit-user-drag:none}
.tile .chk{display:none;position:absolute;top:8px;right:8px;width:24px;height:24px;border-radius:50%;border:2px solid #fff;background:rgba(0,0,0,.2);place-items:center;color:#fff}
.editing .tile .chk,.selmode .tile .chk{display:grid}
.tile.sel{outline:3px solid var(--accent);outline-offset:-3px}
.tile.sel .chk{background:var(--accent);border-color:var(--accent)}
.tile .chk svg{width:14px;height:14px;stroke-width:3;opacity:0}
.tile.sel .chk svg{opacity:1}
.tile.dragging{opacity:.35}
.hint{font-size:13px;color:var(--mute);margin:0 0 10px;display:none}
.editing .hint{display:block}
.ghost{position:fixed;z-index:200;width:72px;height:72px;border-radius:14px;overflow:hidden;pointer-events:none;box-shadow:0 10px 25px rgba(0,0,0,.3);transform:translate(-50%,-60%) rotate(-4deg)}
.ghost img{width:100%;height:100%;object-fit:cover}
.ghost b{position:absolute;right:4px;bottom:4px;background:var(--accent);color:#fff;font-size:12px;min-width:20px;height:20px;border-radius:10px;display:grid;place-items:center}
.row{display:flex;align-items:center;gap:14px;width:100%;padding:14px 0;border-bottom:1px solid var(--line);text-align:left;min-height:72px}
.row img{width:68px;height:68px;border-radius:16px;object-fit:cover;flex:none}
.row .t{flex:1;min-width:0}
.row .t b{display:block;font-size:17px}
.row .t span{font-size:14px;color:var(--mute)}
.pd{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.pd img{width:40px;height:40px;border-radius:10px;object-fit:cover}
.pd .t{flex:1}
.pd .t b{display:block;font-size:16px}
.pd .t span{font-size:13px;color:var(--mute)}
.fab{position:absolute;right:20px;bottom:100px;width:56px;height:56px;border-radius:50%;background:var(--yellow);display:grid;place-items:center;box-shadow:0 8px 20px rgba(0,0,0,.18);z-index:25;transform:scale(0);transition:transform .2s}
.fab.show{transform:none}
.empty{padding:40px 0;text-align:center;color:var(--mute);font-size:14px;column-span:all}
/* SETTINGS */
.app{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--line)}
.app .l{width:36px;height:36px;border-radius:10px;background:var(--bg2);display:grid;place-items:center;font-weight:600;color:var(--mute);flex:none}
.app .t{flex:1;min-width:0}
.app .t b{display:block;font-size:16px}
.app .t span{font-size:13px;color:var(--mute)}
.pillbtn{min-height:44px;padding:0 16px;border-radius:999px;font-weight:600;font-size:14px;color:#222}
.pillbtn.on{background:var(--accent);color:#fff}
/* SHEET */
.scrim{position:absolute;inset:0;background:rgba(0,0,0,.45);opacity:0;pointer-events:none;transition:opacity .25s;z-index:40}
.scrim.show{opacity:1;pointer-events:auto}
.sheet{position:absolute;left:0;right:0;bottom:0;max-height:88%;overflow-y:auto;background:#fff;border-radius:28px 28px 0 0;padding:10px 20px calc(env(safe-area-inset-bottom,0px) + 22px);transform:translateY(105%);transition:transform .3s cubic-bezier(.2,.8,.2,1);z-index:50}
.sheet.show{transform:none}
.grab{width:44px;height:5px;border-radius:3px;background:#d9d9de;margin:0 auto 12px}
.sheet img.p{width:100%;max-height:260px;object-fit:cover;border-radius:18px;display:block}
.kv{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:15px;min-height:40px}
.kv>span:first-child{color:var(--mute)}
.kv>:last-child{text-align:right}
.rule{height:1px;background:var(--line);margin:10px 0}
.tags{display:flex;gap:8px;flex-wrap:wrap}
.pill{border:1px solid #e3e3e8;border-radius:999px;padding:7px 14px;font-size:14px;color:#333}
.pill.btnp{min-height:44px;display:inline-flex;align-items:center}
.pill.sel{background:var(--soft);border-color:#ffb479;color:var(--accent-ink);font-weight:600}
.toast{position:absolute;left:20px;right:20px;bottom:96px;background:#111;color:#fff;border-radius:14px;padding:6px 8px 6px 16px;font-size:14px;display:flex;justify-content:space-between;align-items:center;z-index:90;transform:translateY(20px);opacity:0;pointer-events:none;transition:.25s}
.toast.show{transform:none;opacity:1;pointer-events:auto}
.toast button{color:#ffb98a;font-weight:600;min-height:44px;padding:0 12px}
/* STORY */
.story{position:absolute;inset:0;background:#fff;z-index:60;display:flex;flex-direction:column;padding:calc(env(safe-area-inset-top,0px) + 20px) 20px calc(env(safe-area-inset-bottom,0px) + 20px);transform:translateY(100%);visibility:hidden;transition:transform .35s cubic-bezier(.2,.8,.2,1),visibility .35s;touch-action:pan-y}
.story.show{transform:none;visibility:visible}
.story header{display:flex;justify-content:space-between;align-items:center;font-size:13px;letter-spacing:.06em;color:var(--mute);font-weight:500;min-height:44px}
.story .body{flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;min-height:0;overflow-y:auto;scrollbar-width:none}.story .body::-webkit-scrollbar{display:none}
.slide{width:100%;display:flex;flex-direction:column;align-items:center;margin:auto 0;padding:8px 0;animation:in .35s ease both}#slide{margin:auto 0}
@keyframes in{from{opacity:0;transform:translateX(calc(var(--dir,1)*24px))}to{opacity:1;transform:none}}
.slide .k{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:14px}
.card-img{height:clamp(160px,calc(100dvh - 500px),362px);aspect-ratio:4/5;max-width:100%;border-radius:22px;overflow:hidden;background:var(--bg2);margin-bottom:22px}
.card-img img{width:100%;height:100%;object-fit:cover;display:block}
.slide p.cap{font-size:18px;line-height:1.4;color:#333;max-width:280px}
.slide .tags{justify-content:center;margin-top:16px}.slide .evid{font-size:13px;color:var(--mute);margin-top:14px;display:inline-flex;align-items:center;gap:6px}
.slide .tags .pill{font-size:13px;color:#555}
.slide h2{font-size:30px;letter-spacing:-.02em;margin-bottom:10px}
.meta{display:flex;gap:16px;color:var(--mute);font-size:14px;margin-bottom:22px;align-items:center;flex-wrap:wrap;justify-content:center}
.meta span{display:inline-flex;gap:6px;align-items:center}
.fit{width:fit-content;max-width:100%}.fit .meta{flex-wrap:nowrap;gap:10px;font-size:12px;margin-bottom:14px;justify-content:space-between;white-space:nowrap}.fit .meta span{gap:4px}.fit .meta svg{width:14px;height:14px}.g4{display:grid;grid-template-columns:1fr 1fr;gap:6px;width:0;min-width:100%}
.g4 div{border-radius:14px;overflow:hidden;aspect-ratio:1}
.g4 img{width:100%;height:100%;object-fit:cover;display:block}
.sarrow{position:absolute;top:42%;width:44px;height:44px;display:grid;place-items:center;color:#aaa;border-radius:50%}
.sarrow.l{left:-14px}.sarrow.r{right:-14px}
.sarrow:disabled{opacity:.2;cursor:default}
.dots{display:flex;gap:0;justify-content:center;margin-top:8px}
.dots button{width:18px;height:32px;display:grid;place-items:center}
.dots i{display:block;width:5px;height:5px;border-radius:4px;background:#d9d9de;transition:.25s}
.dots button[aria-current=true] i{width:16px;background:var(--accent)}
.cta{min-height:52px;width:100%;max-width:290px;margin-top:16px}
@media(max-height:760px){.strip{margin-bottom:32px}.thumb{width:92px;height:92px}.head{margin-bottom:28px}#s-home{padding-top:calc(env(safe-area-inset-top,0px) + 32px)}}
@media(max-height:720px){.slide p.cap{font-size:17px}.slide h2{font-size:26px}.g4 div{aspect-ratio:1.25}.card-img{margin-bottom:14px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<main class="phone" id="app">

<!-- HOME -->
<section class="screen active" id="s-home" aria-label="Home">
  <header class="head">
    <div class="date" aria-hidden="true"><small>OCT</small><b>7</b></div>
    <div><div class="muted" style="font-size:15px">Good morning</div><h1>Minami</h1></div>
  </header>
  
  <div class="eyebrow" style="margin-bottom:16px">Photos</div>
  <div class="strip" id="strip"></div>
  <div class="sec"><span class="eyebrow">Today's inspiration</span>
    <button class="reflect" id="openStory">Reflect</button></div>
  <div class="card">
    <div class="hl" aria-live="polite"><span class="hico" id="hico" aria-hidden="true"></span><div><h3 id="hT"></h3><span class="muted" id="hS"></span></div></div>
    <div class="chart" id="chart" role="group" aria-label="Captures by time of day"></div>
    
    <button class="why" id="why" aria-expanded="false" aria-controls="ins"><span>Why this pattern</span><svg class="i s chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>
    <div class="collapse" id="ins"><div><p class="insight">Most of your captures happened in the morning: 9 of 12 before noon, peaking at 10am. Your inspiration seems to arrive early and quietly.</p></div></div>
  </div>
</section>

<!-- ORGANISE -->
<section class="screen" id="s-organise" aria-label="Organise">
  <div class="oh" id="oh"></div>
  <div class="tabs" role="tablist"><button role="tab" id="tab-c" aria-selected="true">Captures</button><button role="tab" id="tab-p" aria-selected="false">Projects</button></div>
  <input class="searchbox" id="q" type="search" placeholder="Search tags, places, projects" aria-label="Search captures">
  <div id="ob"></div>
</section>
<button class="fab" id="fab" aria-label="Create moodboard from selection"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9"/></svg></button>

<!-- SETTINGS -->
<section class="screen" id="s-settings" aria-label="Connected apps">
  <h1 style="margin:6px 0 18px;font-size:24px">Connected apps</h1>
  <div class="eyebrow" style="margin-bottom:4px">Capture</div>
  <div id="apps1"></div>
  <div class="eyebrow" style="margin:22px 0 4px">Create</div>
  <div id="apps2"></div>
  <p class="muted" style="text-align:center;font-size:13px;margin-top:22px">More integrations coming soon</p>
</section>

<nav class="nav" id="nav" aria-label="Main">
  <button data-go="home" aria-label="Home" aria-current="page"><svg class="i" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z"/></svg></button>
  <button data-go="organise" aria-label="Organise"><svg class="i" viewBox="0 0 24 24"><path d="M3 6a2 2 0 012-2h4l2 3h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg></button>
  <button data-go="settings" aria-label="Connected apps"><svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z"/></svg></button>
</nav>

<!-- STORY -->
